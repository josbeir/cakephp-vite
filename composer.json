{
    "name": "josbeir/cakephp-vite",
    "description": "Vite plugin CakePHP",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.5",
        "cakephp/cakephp": "^6.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0",
        "cakephp/plugin-installer": "^2.0.1",
        "cakephp/cakephp-codesniffer": "^6.0@dev",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "CakeVite\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CakeVite\\TestApp\\": "tests/test_app/src/",
            "CakeVite\\Test\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lowest": "validate-prefer-lowest",
        "test": "phpunit --colors=always",
        "test-coverage": "export XDEBUG_MODE=coverage; phpunit --log-junit tmp/coverage/unitreport.xml --coverage-html tmp/coverage --coverage-clover tmp/coverage/coverage.xml",
        "phpstan": "phpstan analyse",
        "cs-check": "phpcs --colors -p -s",
        "cs-fix": "phpcbf --colors -p -s",
        "rector-check": "rector --dry-run --ansi",
        "rector-fix": "rector --ansi"
    }
}
